# Generated automatically by src/00_generate_litellm_config.py
# Do not paste credentials here.
model_list:
  - model_name: <logical-model-alias>
    litellm_params:
      model: openai/<model-id-from-OCI_GENAI_MODELS_JSON>
      api_base: <OCI_GENAI_BASE_URL>
      api_key: os.environ/OCI_GENAI_API_KEY
      extra_headers:
        OpenAI-Project: os.environ/OCI_GENAI_PROJECT_ID
